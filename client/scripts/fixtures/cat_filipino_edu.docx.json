{"document": {"title": "EPP 5 Unang Sumatibong Pagsusulit", "sections": [{"id": 0, "heading": "Aralin 1: Mga Gawain sa Tahanan", "level": 1, "paragraphIds": [0], "tableIds": []}, {"id": 1, "heading": "Mga Halimbawa", "level": 1, "paragraphIds": [1], "tableIds": []}, {"id": 2, "heading": "Pagtataya", "level": 1, "paragraphIds": [2], "tableIds": []}], "paragraphs": [{"id": 0, "text": "Ang aralin na ito ay tungkol sa mga gawain na ginagawa ng mga mag-aaral sa tahanan. Ang layunin ng aralin ay matutunan ng mga bata ang tamang gawain upang makatulong sa pamilya.", "type": "paragraph", "sectionId": 0}, {"id": 1, "text": "Ang paglilinis ng bahay, pagluluto at pag-aalaga ng nakababatang kapatid ay mga halimbawa ng gawain sa tahanan na dapat gawin ng mga mag-aaral.", "type": "paragraph", "sectionId": 1}, {"id": 2, "text": "Sagutin ang pagsusulit tungkol sa aralin. Piliin ang tamang sagot sa bawat tanong at ipasa sa guro.", "type": "paragraph", "sectionId": 2}], "tables": [], "metadata": {"fileName": "cat_filipino_edu.docx", "fileType": "docx", "fileSize": 36878, "wordCount": 81}}, "analysis": {"category": "educational", "confidence": 0.86, "usedFallback": false, "title": "EPP 5 Unang Sumatibong Pagsusulit", "sections": [{"id": 0, "heading": "Aralin 1: Mga Gawain sa Tahanan", "level": 1, "role": "concepts", "wordCount": 32, "paragraphCount": 1, "listItemCount": 0, "tableCount": 0, "density": "sparse", "keywords": ["aralin", "gawain"]}, {"id": 1, "heading": "Mga Halimbawa", "level": 1, "role": "examples", "wordCount": 23, "paragraphCount": 1, "listItemCount": 0, "tableCount": 0, "density": "sparse", "keywords": []}, {"id": 2, "heading": "Pagtataya", "level": 1, "role": "assessment", "wordCount": 17, "paragraphCount": 1, "listItemCount": 0, "tableCount": 0, "density": "sparse", "keywords": []}], "keywords": ["aralin", "gawain", "tahanan", "halimbawa", "pagsusulit", "mag-aaral", "tamang"], "scores": [{"category": "educational", "score": 27, "matchedKeywords": ["aralin", "gawain"