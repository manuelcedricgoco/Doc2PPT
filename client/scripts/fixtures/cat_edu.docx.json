{"document": {"title": "Lesson: Parts of a Computer", "sections": [{"id": 0, "heading": "Learning Objectives", "level": 1, "paragraphIds": [0], "tableIds": []}, {"id": 1, "heading": "Key Concepts", "level": 1, "paragraphIds": [1], "tableIds": []}, {"id": 2, "heading": "Examples", "level": 1, "paragraphIds": [2], "tableIds": []}, {"id": 3, "heading": "Activity", "level": 1, "paragraphIds": [3], "tableIds": []}, {"id": 4, "heading": "Assessment", "level": 1, "paragraphIds": [4], "tableIds": []}, {"id": 5, "heading": "Summary", "level": 1, "paragraphIds": [5], "tableIds": []}], "paragraphs": [{"id": 0, "text": "After this lesson, students will be able to name the main parts of a computer and explain what each part does.", "type": "paragraph", "sectionId": 0}, {"id": 1, "text": "A computer has input devices, output devices, a processor and storage. The definition of hardware is the physical parts you can touch.", "type": "paragraph", "sectionId": 1}, {"id": 2, "text": "A keyboard is an example of an input device. A monitor is an example of an output device. Ask the students to point to each one in the classroom.", "type": "paragraph", "sectionId": 2}, {"id": 3, "text": "Divide the class into groups. Each group lists five computer parts and tells the teacher whether each is input, output or storage. This exercise takes ten minutes.", "type": "paragraph", "sectionId": 3}, {"id": 4, "text": "Give a short quiz of five questions about the lesson to check what the learners understood.", "type": "paragraph", "sectionId": 4}, {"id": 5, "text": "Computers have input, output, processing and storage parts that work together.", "type": "paragraph", "sectionId": 5}], "tables": [], "metadata": {"fileName": "cat_edu.docx", "fileType": "docx", "fileSize": 37051, "wordCount": 134}}, "analysis": {"category": "educational", "confidence": 0.82, "usedFallback": false, "title": "Lesson: Parts of a Computer", "sections": [{"id": 0, "heading": "Learning Objectives", "level": 1, "role": "objectives", "wordCount": 21, "paragraphCount": 1, "listItemCount": 0, "tableCount": 0, "density": "sparse", "keywords": []}, {"id": 1, "heading": "Key Concepts", "level": 1, "role": "concepts", "wordCount": 22, "paragraphCount": 1, "listItemCount": 0, "tableCount": 0, "density": "sparse", "keywords": []}, {"id": 2, "heading": "Examples", "level": 1, "role": "examples", "wordCount": 29, "paragraphCount": 1, "listItemCount": 0, "tableCount": 0, "density": "sparse", "keywords": ["example", "device"]}, {"id": 3, "heading": "Activity", "level": 1, "role": "activity", "wordCount": 27, "paragraphCount": 1, "listItemCount": 0, "tableCount": 0, "density": "sparse", "keywords": ["groups"]}, {"id": 4, "heading": "Assessment", "level": 1, "role": "assessment", "wordCount": 16, "paragraphCount": 1, "listItemCount": 0, "tableCount": 0, "density": "sparse", "keywords": []}, {"id": 5, "heading": "Summary", "level": 1, "role": "summary", "wordCount": 11, "paragraphCount": 1, "listItemCount": 0, "tableCount": 0, "density": "sparse", "keywords": []}], "keywords": ["parts", "computer", "input", "devices", "output", "lesson", "example", "input devices", "output devices", "input output"], "scores": [{"category": "educational", "score": 22, "matchedKeywords": ["lesson", "learning objectives", "key concepts", "students", "definition", "teacher", "classroom", "quiz", "exercise", "learners", "examples", "assessment", "summary"]}, {"category": "academic", "score": 1, "matchedKeywords": ["objectives"]}, {"category": "it", "score": 0, "matchedKeywords": []}, {"category": "business", "score": 0, "matchedKeywords": []}, {"category": "marketing", "score": 0, "matchedKeywords": []}], "matchedKeywords": ["lesson", "learning objectives", "key concepts", "students", "definition", "teacher", "classroom", "quiz"]}}