{"document": {"title": "Kape Barako Cafe Business Proposal", "sections": [{"id": 0, "heading": "Executive Summary", "level": 1, "paragraphIds": [0], "tableIds": []}, {"id": 1, "heading": "Target Market", "level": 1, "paragraphIds": [1], "tableIds": []}, {"id": 2, "heading": "Competitors", "level": 1, "paragraphIds": [2], "tableIds": []}, {"id": 3, "heading": "Business Model", "level": 1, "paragraphIds": [3], "tableIds": []}, {"id": 4, "heading": "Financial Overview", "level": 1, "paragraphIds": [4], "tableIds": []}, {"id": 5, "heading": "Conclusion", "level": 1, "paragraphIds": [5], "tableIds": []}], "paragraphs": [{"id": 0, "text": "Kape Barako is a small cafe business that plans to serve locally grown coffee to office workers and students. This proposal explains the market, our customers, expected revenue and the investment we need to open the first branch.", "type": "paragraph", "sectionId": 0}, {"id": 1, "text": "Our customers are students and employees within a ten minute walk of the cafe. Market research shows that most of them buy coffee at least three times a week.", "type": "paragraph", "sectionId": 1}, {"id": 2, "text": "Two chain stores and one local shop sell coffee nearby. Our competitive advantage is lower pricing and locally sourced beans that give a better profit margin.", "type": "paragraph", "sectionId": 2}, {"id": 3, "text": "Revenue will come from drinks, pastries and bean sales. We expect to reach profit in the second year based on sales projections.", "type": "paragraph", "sectionId": 3}, {"id": 4, "text": "The company needs an investment of 500000 pesos for equipment, rent and inventory. Investors will receive a share of the profit each quarter.", "type": "paragraph", "sectionId": 4}, {"id": 5, "text": "This business is a sound investment for the local market.", "type": "paragraph", "sectionId": 5}], "tables": [], "metadata": {"fileName": "cat_business.docx", "fileType": "docx", "fileSize": 37169, "wordCount": 158}}, "analysis": {"category": "