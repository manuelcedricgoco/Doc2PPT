{"document": {"title": "Barangay Records Management System", "sections": [{"id": 0, "heading": "Project Overview", "level": 1, "paragraphIds": [0], "tableIds": []}, {"id": 1, "heading": "Features", "level": 1, "paragraphIds": [1, 2, 3], "tableIds": []}, {"id": 2, "heading": "System Architecture", "level": 1, "paragraphIds": [4], "tableIds": []}, {"id": 3, "heading": "Technology Stack", "level": 1, "paragraphIds": [5], "tableIds": []}, {"id": 4, "heading": "Testing", "level": 1, "paragraphIds": [6], "tableIds": []}, {"id": 5, "heading": "Conclusion", "level": 1, "paragraphIds": [7], "tableIds": []}], "paragraphs": [{"id": 0, "text": "This software project is a web application that lets barangay staff manage resident records in a central database. The system replaces paper logbooks and gives the office a faster way to search and print certificates.", "type": "paragraph", "sectionId": 0}, {"id": 1, "text": "Resident registry with household grouping", "type": "list-item", "sectionId": 1}, {"id": 2, "text": "Certificate issuance with printable templates", "type": "list-item", "sectionId": 1}, {"id": 3, "text": "Monthly reports for officials", "type": "list-item", "sectionId": 1}, {"id": 4, "text": "The application uses a React frontend, an Express backend and a MySQL database. The frontend calls a REST API on the server, and the server reads and writes records in the database.", "type": "paragraph", "sectionId": 2}, {"id": 5, "text": "The development team used React, Node.js, Express and MySQL. Source code is kept in GitHub and the server is deployed on a small cloud instance.", "type": "paragraph", "sectionId": 3}, {"id": 6, "text": "The team ran unit tests on the API and manual tests on the user interface. Bugs found during testing were fixed before deployment of the final version.", "type": "paragraph", "sectionId": 4}, {"id": 7, "text": "The system was implemented on schedule and is now used by the barangay office.", "type": "paragraph", "sectionId": 5}], "tables": [], "metadata": {"fileName": "cat_it.docx", "fileType": "docx", "fileSize": 37187, "wordCount": 156}}, "analysis": {"category": "it", "confidence": 0.85, "usedFallback": false, "title": "Barangay Records Management System", "sections": [{"id": 0, "heading": "Project Overview", "level": 1, "role": "overview", "wordCount": 35, "paragraphCount": 1, "listItemCount": 0, "tableCount": 0, "density": "sparse", "keywords": []}, {"id": 1, "heading": "Features", "level": 1, "role": "features", "wordCount": 14, "paragraphCount": 0, "listItemCount": 3, "tableCount": 0, "density": "sparse", "keywords": []}, {"id": 2, "heading": "System Architecture", "level": 1, "role": "architecture", "wordCount": 32, "paragraphCount": 1, "listItemCount": 0, "tableCount": 0, "density": "sparse", "keywords": ["frontend", "database", "server"]}, {"id": 3, "heading": "Technology Stack", "level": 1, "role": "techstack", "wordCount": 25, "paragraphCount": 1, "listItemCount": 0, "tableCount": 0, "density": "sparse", "keywords": []}, {"id": 4, "heading": "Testing", "level": 1, "role": "testing", "wordCount": 27, "paragraphCount": 1, "listItemCount": 0, "tableCount": 0, "density": "sparse", "keywords": ["tests"]}, {"id": 5, "heading": "Conclusion", "level": 1, "role": "conclusion", "wordCount": 14, "paragraphCount": 1, "listItemCount": 0, "tableCount": 0, "density": "sparse", "keywords": []}], "keywords": ["system", "barangay", "records", "database", "server", "project", "testing", "application", "resident", "office"], "scores": [{"category": "it", "score": 28.8, "matchedKeywords": ["database", "architecture", "technology stack", "server", "system", "frontend", "api", "testing", "software", "web application", "backend", "user interface", "deployment", "source code", "cloud", "features", "application", "development"]}, {"category": "academic", "score": 1, "matchedKeywords": ["conclusion"]}, {"category": "business", "score": 0, "matchedKeywords": []}, {"category": "educational", "score": 0, "matchedKeyword