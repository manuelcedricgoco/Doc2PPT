{"document": {"title": "Student Attendance and Academic Performance", "sections": [{"id": 0, "heading": "Introduction", "level": 1, "page": 1, "paragraphIds": [0], "tableIds": []}, {"id": 1, "heading": "Statement of the Problem", "level": 1, "page": 1, "paragraphIds": [1, 2, 3, 4], "tableIds": []}, {"id": 2, "heading": "Methodology", "level": 1, "page": 1, "paragraphIds": [], "tableIds": []}, {"id": 3, "heading": "Respondents", "level": 2, "page": 1, "paragraphIds": [5], "tableIds": []}, {"id": 4, "heading": "Results", "level": 1, "page": 1, "paragraphIds": [6], "tableIds": [0]}, {"id": 5, "heading": "Conclusion", "level": 1, "page": 1, "paragraphIds": [7], "tableIds": []}], "paragraphs": [{"id": 0, "text": "Regular attendance is widely viewed as a basic condition for learning in schools. This study looks at how often students attend class and how that attendance is related to their grades during the school year 2023-2024.", "type": "paragraph", "sectionId": 0, "page": 1}, {"id": 1, "text": "The study sought to answer the following questions about the 120 respondents:", "type": "paragraph", "sectionId": 1, "page": 1}, {"id": 2, "text": "What is the average attendance rate of the students?", "type": "list-item", "sectionId": 1, "page": 1}, {"id": 3, "text": "Is there a significant relationship between attendance and grades?", "type": "list-item", "sectionId": 1, "page": 1}, {"id": 4, "text": "What actions can the school take to improve attendance?", "type": "list-item", "sectionId": 1, "page": 1}, {"id": 5, "text": "The respondents were 120 Grade 10 students selected through stratified random sampling from three sections of the school.", "type": "paragraph", "sectionId": 3, "page": 1}, {"id": 6, "text": "Table 1 shows the average attendance rate and general average of each section.", "type": "paragraph", "sectionId": 4, "page": 1}, {"id": 7, "text": "Students with higher attendance rates also tended to have higher general averages, and the school is encouraged to monitor absences early.", "type": "paragraph", "sectionId": 5, "page": 1}], "tables": [{"id": 0, "rows": [["Section", "Attendance (%)", "General Average"], ["Rizal", "94.5", "88.2"], ["Bonifacio", "91.0", "85.7"], ["Mabini", "89.3", "84.1"]], "hasHeader": true, "sectionId": 4, "page": 1}], "metadata": {"fileName": "academic.pdf", "fileType": "pdf", "fileSize": 38462, "pageCount": 1, "wordCount": 149}}, "analysis": {"category": "academic", "confidence": 0.71, "usedFallback": false, "title": "Student Attendance and Academic Performance", "sections": [{"id": 0, "heading": "Introduction", "level": 1, "role": "introduction", "wordCount": 36, "paragraphCount": 1, "listItemCount": 0, "tableCount": 0, "density": "sparse", "keywords": ["attendance", "schools"]}, {"id": 1, "heading": "Statement of the Problem", "level": 1, "role": "problem", "wordCount": 39, "paragraphCount": 1, "listItemCount": 3, "tableCount": 0, "density": "sparse", "keywords": ["attendance"]}, {"id": 2, "heading": "Methodology", "level": 1, "role": "methodology", "wordCount": 0, "paragraphCount": 0, "listItemCount": 0, "tableCount": 0, "density": "sparse", "keywords": []}, {"id": 3, "heading": "Respondents", "level": 2, "role": "methodology", "wordCount": 18, "paragraphCount": 1, "listItemCount": 0, "tableCount": 0, "density": "sparse", "keywords": []}, {"id": 4, "heading": "Results", "level": 1, "role": "results", "wordCount": 26, "paragraphCount": 1, "listItemCount": 0, "tableCount": 1, "density": "sparse", "keywords": ["average"]}, {"id": 5, "heading": "Conclusion", "level": 1, "role": "conclusion", "wordCount": 21, "paragraphCount": 1, "listItemCount": 0, "tableCount": 0, "density": "sparse", "keywords": []}], "keywords": ["attendance", "students", "school", "attendance rate", "average", "respondents", "average attendance", "general average", "grades", "study"], "scores": [{"category": "academic", "score": 18, "matchedKeywords": ["respondents", "statement of the problem", "methodology", "sampling", "sign